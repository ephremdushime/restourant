# ==============================================================================
# RestoPass Production & Pilot Environment Configuration
# ==============================================================================
# Copy this file to .env and configure strong random secrets before going live.
#
# DUAL DEPLOYMENT MODES:
# 1. Cloud Production (single app instance in this Compose stack):
#    Configure PostgreSQL, Redis, role bootstrap credentials, a domain, and private S3-compatible storage.
#    This Compose file is not evidence of a tested 50,000-DAU capacity or horizontal scaling.
#
# 2. Offline On-Premises Reception Laptop:
#    Development/local mode only. It is not a production failover substitute.
#    Production requires PostgreSQL and Redis; local scanner resilience is a separate edge-sync design.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. Cryptographic Secrets (MANDATORY in NODE_ENV=production >= 32 characters)
# ------------------------------------------------------------------------------
# Used by server.ts to sign and verify session tokens
SESSION_SECRET=""

# Used by server.ts and cryptoService.ts to derive restaurant & customer HMAC keys
RESTOPASS_MASTER_SECRET=""
RESTOPASS_SUPERADMIN_PASSWORD=""

# Compose-required values. Use long random URL-safe values for passwords.
DOMAIN="restopass.example.com"
POSTGRES_DB="restopass"
POSTGRES_USER="restopass_app"
POSTGRES_PASSWORD=""
REDIS_PASSWORD=""

# ------------------------------------------------------------------------------
# 2. Distributed PostgreSQL Relational Persistence (Cloud Scalability Item 1)
# ------------------------------------------------------------------------------
# Example: postgres://restopass:your_db_password@postgres-host:5432/restopass
DATABASE_URL="" # Not used by Compose; Compose constructs this from POSTGRES_*
PGSSLMODE="require"
PGMAX_CONNECTIONS=25

# ------------------------------------------------------------------------------
# 3. Managed Redis Node (Cloud Scalability Item 2: 30s QR Replay Guard)
# ------------------------------------------------------------------------------
# Example: redis://:your_redis_password@redis-host:6379
REDIS_URL="" # Not used by Compose; Compose constructs this from REDIS_PASSWORD

# ------------------------------------------------------------------------------
# 4. S3-Compatible Object Storage (Cloud Scalability Item 3: Patron Photos)
# ------------------------------------------------------------------------------
# Supports AWS S3, DigitalOcean Spaces, Cloudflare R2, MinIO
S3_BUCKET=""
S3_REGION="us-east-1"
# For DigitalOcean Spaces: https://nyc3.digitaloceanspaces.com
# For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional delivery URL prefix; do not configure a public bucket/CDN for patron photos.
S3_PUBLIC_URL_PREFIX=""

# ------------------------------------------------------------------------------
# 5. Optional Integrations
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"

# Encrypted database + local upload-volume backups (use a unique random passphrase).
RESTOPASS_BACKUP_ENCRYPTION_KEY="generate_a_unique_backup_encryption_passphrase_at_least_32_characters"
# Independent integrity key; keep separately from the encryption passphrase.
RESTOPASS_BACKUP_HMAC_KEY="generate_a_separate_random_backup_integrity_key_at_least_32_characters"
RESTOPASS_BACKUP_DIR="/var/backups/restopass"
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
