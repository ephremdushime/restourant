# ==============================================================================
# RestoPass Production & Pilot Environment Configuration
# ==============================================================================
# Copy this file to .env and configure strong random secrets before going live.
#
# DUAL DEPLOYMENT MODES:
# 1. Cloud Production (single app instance in this Compose stack):
#    Configure PostgreSQL, Redis, role bootstrap credentials, a domain, and private S3-compatible storage.
#    This Compose file is not evidence of a tested 50,000-DAU capacity or horizontal scaling.
#
# 2. Offline On-Premises Reception Laptop:
#    Development/local mode only. It is not a production failover substitute.
#    Production requires PostgreSQL and Redis; local scanner resilience is a separate edge-sync design.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production
# Use cloud for hosted deployments (requires PostgreSQL + Redis); standalone is for a single offline device.
RESTOPASS_DEPLOYMENT_MODE=standalone
# One trusted reverse proxy hop (e.g. host-local Nginx/Caddy) in front of the loopback-only app port.
# Do not use 'true' unless every forwarding proxy is trusted and direct app access is blocked.
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 1. Cryptographic Secrets (MANDATORY in NODE_ENV=production >= 32 characters)
# ------------------------------------------------------------------------------
# Used by server.ts to sign and verify session tokens
SESSION_SECRET="GENERATE_A_32_PLUS_CHAR_RANDOM_PRODUCTION_SESSION_SECRET"

# Used exclusively by server.ts on the backend to derive restaurant & customer HMAC keys (never exposed to browser)
RESTOPASS_MASTER_SECRET="GENERATE_A_32_PLUS_CHAR_RANDOM_PRODUCTION_MASTER_SECRET"

# Compose-required values. Use long random URL-safe values for passwords.
DOMAIN="restopass.example.com"
POSTGRES_DB="restopass"
POSTGRES_USER="restopass_app"
POSTGRES_PASSWORD=""
REDIS_PASSWORD=""

# ------------------------------------------------------------------------------
# 2. Administrative Credentials (MANDATORY in production)
# ------------------------------------------------------------------------------
# Super Admin global platform management password (minimum 12 characters recommended)
RESTOPASS_SUPERADMIN_PASSWORD="CONFIGURE_STRONG_SUPERADMIN_PASSWORD_HERE"

# Tenant-specific Restaurant Admin accounts (JSON keyed by restaurant code).
# Each tenant must have its own username and unique strong password (16+ chars; 32+ recommended).
# Production login rejects the legacy shared RESTOPASS_BOSS_PASSWORD setting.
RESTOPASS_RESTAURANT_ADMIN_ACCOUNTS='{"RW01":{"username":"manager@your-restaurant.rw","password":"REPLACE_WITH_A_UNIQUE_32_CHAR_SECRET"}}'

# Do not configure a shared production staff PIN. Provision a unique PIN per staff account.
# RESTOPASS_STAFF_DEFAULT_PIN=""

# ------------------------------------------------------------------------------
# 3. Distributed PostgreSQL Relational Persistence (Cloud Scalability Item 1)
# ------------------------------------------------------------------------------
# Example: postgres://restopass:your_db_password@postgres-host:5432/restopass
DATABASE_URL="" # Not used by Compose; Compose constructs this from POSTGRES_*
PGSSLMODE="verify-full"
PGMAX_CONNECTIONS=25

# ------------------------------------------------------------------------------
# 4. Managed Redis Node (Cloud Scalability Item 2: 30s QR Replay Guard)
# ------------------------------------------------------------------------------
# Example: redis://:your_redis_password@redis-host:6379
REDIS_URL="" # Not used by Compose; Compose constructs this from REDIS_PASSWORD

# ------------------------------------------------------------------------------
# 5. S3-Compatible Object Storage (Cloud Scalability Item 3: Patron Photos)
# ------------------------------------------------------------------------------
# Supports AWS S3, DigitalOcean Spaces, Cloudflare R2, MinIO
S3_BUCKET=""
S3_REGION="us-east-1"
# For DigitalOcean Spaces: https://nyc3.digitaloceanspaces.com
# For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Keep the bucket private. Patron portraits are served only through authenticated API reads.
# Do not configure a public CDN URL or public-read object ACL.
S3_PUBLIC_URL_PREFIX=""

# ------------------------------------------------------------------------------
# 6. MTN Collections (disabled until the verified MTN adapter is implemented)
# ------------------------------------------------------------------------------
MTN_COLLECTIONS_ENABLED=false
# Never enable payment callbacks based only on a client-supplied status or shared secret.

# ------------------------------------------------------------------------------
# 7. Optional Integrations
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"

# Encrypted database + private-photo backups. The scripts require exactly 64 hexadecimal characters.
# Generate a unique key with: openssl rand -hex 32. Store it outside the application server and Google Drive.
RESTOPASS_BACKUP_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARACTERS_FROM_OPENSSL_RAND_HEX_32"
# The Google Drive backup scripts derive a domain-separated HMAC key from the encryption key.
# RESTOPASS_BACKUP_HMAC_KEY is only for the legacy S3 backup worker and is not used by the Drive scripts.
RESTOPASS_BACKUP_DIR="/var/backups/restopass"
BACKUP_INTERVAL_SECONDS=43200
BACKUP_RETENTION_DAYS=30

# Off-site disaster recovery: configure rclone OAuth for a dedicated Google account.
# Example remote: restopass-drive:restopass-backups (create with `rclone config`).
RESTOPASS_GOOGLE_DRIVE_REMOTE="restopass-drive:restopass-backups"
# Keep the rclone OAuth config private (0600); never commit it.
RCLONE_CONFIG=""
RESTOPASS_BACKUP_RETENTION_DAYS=30
# Host cron runs paired database + photo backups at 00:00 and 18:00 Africa/Kigali.
# BACKUP_INTERVAL_SECONDS applies only to the optional legacy container worker.

# ----------------------------------------------------------------------
# 6. Restaurant SaaS MTN MoMo collection (OFF by default)
# Restaurant software fees only; never customer meal top-ups.
# Keep disabled until Bestie Companies Ltd's merchant onboarding is approved.
# For production-like staging only, sandbox requires explicit sandbox approval.
# ----------------------------------------------------------------------
RESTOPASS_SAAS_MTN_ENABLED=false
RESTOPASS_SAAS_MTN_SANDBOX_APPROVED=false
RESTOPASS_SAAS_MTN_PRODUCTION_APPROVED=false
MTN_MOMO_TARGET_ENVIRONMENT=
MTN_MOMO_PRODUCTION_TARGET=
MTN_MOMO_COLLECTION_API_USER=
MTN_MOMO_COLLECTION_API_KEY=
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
