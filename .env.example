# RestoPass Production & Pilot Environment Configuration
# Copy this file to .env and configure strong random 32+ character secrets before running in NODE_ENV=production.

# Server Port
PORT=3000

# Mandatory in NODE_ENV=production (>= 32 characters):
# Used by server.ts to sign and verify session tokens.
SESSION_SECRET="REPLACE_WITH_32_PLUS_CHAR_RANDOM_PRODUCTION_SESSION_SECRET"

# Mandatory in NODE_ENV=production (>= 32 characters):
# Used by server.ts and cryptoService.ts to derive restaurant and customer HMAC keys for QR & PVC card verification.
RESTOPASS_MASTER_SECRET="REPLACE_WITH_32_PLUS_CHAR_RANDOM_PRODUCTION_MASTER_SECRET"
VITE_RESTOPASS_MASTER_KEY="REPLACE_WITH_32_PLUS_CHAR_RANDOM_PRODUCTION_MASTER_SECRET"

# Optional AI Studio / Deployment variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
