# ==============================================================================
# RestoPass Production & Pilot Environment Configuration
# ==============================================================================
# Copy this file to .env and configure strong random secrets before going live.
#
# DUAL DEPLOYMENT MODES:
# 1. Cloud Production (50,000 DAU):
#    Set DATABASE_URL, REDIS_URL, and S3_* variables to enable horizontal auto-scaling,
#    relational PostgreSQL append-only ledgers, atomic Redis replay prevention,
#    and CDN object storage for patron portrait photos.
#
# 2. Offline On-Premises Reception Laptop:
#    Leave DATABASE_URL, REDIS_URL, and S3_* unset. The application will run 100%
#    standalone with atomic JSON file persistence and in-memory replay caches,
#    operating uninterrupted during campus dining hours even without internet.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production
# Set to '1' or 'true' when deployed behind cloud reverse proxies (Cloudflare, AWS ALB, Nginx, Railway, Render)
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 1. Cryptographic Secrets (MANDATORY in NODE_ENV=production >= 32 characters)
# ------------------------------------------------------------------------------
# Used by server.ts to sign and verify session tokens
SESSION_SECRET="GENERATE_A_32_PLUS_CHAR_RANDOM_PRODUCTION_SESSION_SECRET"

# Used by server.ts to derive restaurant & customer HMAC keys
RESTOPASS_MASTER_SECRET="GENERATE_A_32_PLUS_CHAR_RANDOM_PRODUCTION_MASTER_SECRET"

# ------------------------------------------------------------------------------
# 2. Administrative Credentials (MANDATORY in production)
# ------------------------------------------------------------------------------
# Super Admin global platform management password (minimum 12 characters recommended)
RESTOPASS_SUPERADMIN_PASSWORD="CONFIGURE_STRONG_SUPERADMIN_PASSWORD_HERE"

# Default fallback Restaurant Boss password (minimum 8 characters)
RESTOPASS_BOSS_PASSWORD="CONFIGURE_STRONG_BOSS_PASSWORD_HERE"

# Optional default Staff PIN for newly unassigned station terminals (4-8 digits)
RESTOPASS_STAFF_DEFAULT_PIN="1234"

# ------------------------------------------------------------------------------
# 3. Distributed PostgreSQL Relational Persistence (Cloud Scalability Item 1)
# ------------------------------------------------------------------------------
# Example: postgres://restopass:your_db_password@postgres-host:5432/restopass
DATABASE_URL=""
PGSSLMODE="require"
PGMAX_CONNECTIONS=25

# ------------------------------------------------------------------------------
# 4. Managed Redis Node (Cloud Scalability Item 2: 30s QR Replay Guard)
# ------------------------------------------------------------------------------
# Example: redis://:your_redis_password@redis-host:6379
REDIS_URL=""

# ------------------------------------------------------------------------------
# 5. S3-Compatible Object Storage (Cloud Scalability Item 3: Patron Photos)
# ------------------------------------------------------------------------------
# Supports AWS S3, DigitalOcean Spaces, Cloudflare R2, MinIO
S3_BUCKET=""
S3_REGION="us-east-1"
# For DigitalOcean Spaces: https://nyc3.digitaloceanspaces.com
# For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public CDN URL prefix (e.g. https://cdn.restopass.com or https://bucket.nyc3.cdn.digitaloceanspaces.com)
S3_PUBLIC_URL_PREFIX=""
# Set S3_OBJECT_ACL='public-read' only if using legacy buckets with ACLs enabled
# S3_OBJECT_ACL=""

# ------------------------------------------------------------------------------
# 6. Payment Webhook Security (MTN MoMo / Airtel Money)
# ------------------------------------------------------------------------------
# Optional webhook shared secret to verify incoming payment callbacks
MOMO_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 7. Optional Integrations
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
