# ==============================================================================
# RestoPass Production & Pilot Environment Configuration
# ==============================================================================
# Copy this file to .env and configure strong random secrets before going live.
#
# DUAL DEPLOYMENT MODES:
# 1. Cloud Production (single-instance controlled pilot):
#    Set DATABASE_URL, REDIS_URL, and S3_* variables to enable horizontal auto-scaling,
#    relational PostgreSQL persistence, atomic Redis replay prevention,
#    and CDN object storage for patron portrait photos.
#
# 2. Offline On-Premises Reception Laptop:
#    Leave DATABASE_URL, REDIS_URL, and S3_* unset. The application will run 100%
#    standalone with atomic JSON file persistence and in-memory replay caches,
#    operating uninterrupted during campus dining hours even without internet.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production
# Use cloud for hosted deployments (requires PostgreSQL + Redis); standalone is for a single offline device.
RESTOPASS_DEPLOYMENT_MODE=standalone
# One trusted reverse proxy hop (e.g. host-local Nginx/Caddy) in front of the loopback-only app port.
# Do not use 'true' unless every forwarding proxy is trusted and direct app access is blocked.
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 1. Cryptographic Secrets (MANDATORY in NODE_ENV=production >= 32 characters)
# ------------------------------------------------------------------------------
# Used by server.ts to sign and verify session tokens
SESSION_SECRET="GENERATE_A_32_PLUS_CHAR_RANDOM_PRODUCTION_SESSION_SECRET"

# Used by server.ts to derive restaurant & customer HMAC keys
RESTOPASS_MASTER_SECRET="GENERATE_A_32_PLUS_CHAR_RANDOM_PRODUCTION_MASTER_SECRET"

# ------------------------------------------------------------------------------
# 2. Administrative Credentials (MANDATORY in production)
# ------------------------------------------------------------------------------
# Super Admin global platform management password (minimum 12 characters recommended)
RESTOPASS_SUPERADMIN_PASSWORD="CONFIGURE_STRONG_SUPERADMIN_PASSWORD_HERE"

# Tenant-specific Restaurant Admin accounts (JSON keyed by restaurant code).
# Each tenant must have its own username and unique strong password (16+ chars; 32+ recommended).
# Production login rejects the legacy shared RESTOPASS_BOSS_PASSWORD setting.
RESTOPASS_RESTAURANT_ADMIN_ACCOUNTS='{"RW01":{"username":"manager@your-restaurant.rw","password":"REPLACE_WITH_A_UNIQUE_32_CHAR_SECRET"}}'

# Do not configure a shared production staff PIN. Provision a unique PIN per staff account.
# RESTOPASS_STAFF_DEFAULT_PIN=""

# ------------------------------------------------------------------------------
# 3. Distributed PostgreSQL Relational Persistence (Cloud Scalability Item 1)
# ------------------------------------------------------------------------------
# Example: postgres://restopass:your_db_password@postgres-host:5432/restopass
DATABASE_URL=""
PGSSLMODE="verify-full"
PGMAX_CONNECTIONS=10

# ------------------------------------------------------------------------------
# 3a. Encrypted PostgreSQL Backup Key (host-side backup scripts)
# Generate once and store securely outside the backup directory:
# openssl rand -hex 32
RESTOPASS_BACKUP_ENCRYPTION_KEY="GENERATE_64_HEX_CHAR_BACKUP_KEY"

# ------------------------------------------------------------------------------
# 4. Managed Redis Node (Cloud Scalability Item 2: 30s QR Replay Guard)
# ------------------------------------------------------------------------------
# Example: redis://:your_redis_password@redis-host:6379
REDIS_URL=""

# ------------------------------------------------------------------------------
# 5. S3-Compatible Object Storage (Cloud Scalability Item 3: Patron Photos)
# ------------------------------------------------------------------------------
# Supports AWS S3, DigitalOcean Spaces, Cloudflare R2, MinIO
S3_BUCKET=""
S3_REGION="us-east-1"
# For DigitalOcean Spaces: https://nyc3.digitaloceanspaces.com
# For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Keep the bucket private. Patron portraits are served only through authenticated API reads.
# Do not configure a public CDN URL or public-read object ACL.

# ------------------------------------------------------------------------------
# 6. MTN Collections (disabled until the verified MTN adapter is implemented)
# ------------------------------------------------------------------------------
MTN_COLLECTIONS_ENABLED=false
# Never enable payment callbacks based only on a client-supplied status or shared secret.

# ------------------------------------------------------------------------------
# 7. Optional Integrations
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
